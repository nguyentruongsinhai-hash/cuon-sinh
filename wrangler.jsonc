{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "cuon-sinh",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Giữ địa chỉ thử workers.dev và địa chỉ xem thử của nhánh luôn bật.
	// Thiếu hai dòng này, hễ thêm "routes" là wrangler tự tắt cả hai.
	"workers_dev": true,
	"preview_urls": true
}
