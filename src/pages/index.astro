---
// Trang chủ Cuốn Sinh. Đầu trang, chân trang và giao diện sáng/tối nằm ở khung chung Base.astro.
import FormDatBan from '../components/FormDatBan.astro';
import Base from '../layouts/Base.astro';
import TheCombo from '../components/TheCombo.astro';
import TheMon from '../components/TheMon.astro';
import { MESSENGER_URL } from '../consts';
import { COMBO, NHOM_MON, giaVN, monTrangChu, nhomTrangChu } from '../data/thuc-don.mjs';

// Mục thực đơn: tab "Nổi bật" và mỗi nhóm tối đa 4 món, đủ món nằm ở trang /thuc-don/.
const nhomHome = nhomTrangChu();
const soNguoi = [...new Set(COMBO.map((c) => c.nguoi))];
const monBia = NHOM_MON.flatMap((n) => n.mon).find((m) => m.ten === 'Set cuốn tổng hợp');
const comboRe = COMBO.reduce((a, b) => (b.gia < a.gia ? b : a));
---

<Base ogType="restaurant">
<Fragment slot="head">
<link rel="preload" as="image" href="/assets/img/set-cuon-tong-hop.webp" fetchpriority="high">
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "Nhà hàng Cuốn Sinh",
  "url": "https://cuonsinh.com/",
  "telephone": "+84844566922",
  "servesCuisine": ["Món Việt", "Món cuốn", "Lẩu"],
  "hasMenu": "https://cuonsinh.com/thuc-don/",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Số 3, ngõ 58 Vũ Trọng Phụng",
    "addressLocality": "Thanh Xuân",
    "addressRegion": "Hà Nội",
    "addressCountry": "VN"
  },
  "openingHoursSpecification": [
    {"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "09:00", "closes": "14:00"},
    {"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "16:30", "closes": "22:00"}
  ],
  "sameAs": ["https://www.facebook.com/nhahangcuonsinh"]
}
</script>
</Fragment>

<!-- ============ 1. HERO ============ -->
<section class="hero">
  <div class="wrap hero__in">
    <div class="hero__text">
      <p class="eyebrow">Món cuốn · Lẩu · Món Việt chia sẻ</p>
      <h1>Tươi ngon mỗi cuốn,<br><span class="hl">ấm áp mỗi bữa.</span></h1>
      <p class="lead">Cuốn Sinh là quán ăn Việt để cả nhà, cả nhóm ngồi lại, cùng cuốn, cùng chia sẻ. Ngay ngõ 58 Vũ Trọng Phụng, Thanh Xuân.</p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="#dat-ban">Đặt bàn ngay</a>
        <a class="btn btn--ghost btn--lg" href="#mon-noi-bat">Xem thực đơn</a>
      </div>
      <p class="open" id="trang-thai-mo" hidden><span class="open__dot" aria-hidden="true"></span><span class="open__txt"></span></p>
    </div>
    <div class="hero__media">
      <img src="/assets/img/set-cuon-tong-hop.webp" alt="Set cuốn tổng hợp của Cuốn Sinh với bánh tráng, rau sống, nem lụi và thịt" width="667" height="1000" fetchpriority="high">
      <div class="hero__tag">
        <strong>Set cuốn tổng hợp</strong>
        <span>{giaVN(monBia.gia)}</span>
      </div>
    </div>
  </div>

  <div class="wrap">
    <ul class="facts">
      <li><strong>9:00 - 14:00</strong><span>Ca trưa</span></li>
      <li><strong>16:30 - 22:00</strong><span>Ca tối</span></li>
      <li><strong>2 tầng · 76 chỗ</strong><span>Hợp nhóm bạn, gia đình</span></li>
      <li><strong>Từ {giaVN(comboRe.gia)}</strong><span>Combo cho {comboRe.nguoi} người</span></li>
    </ul>
  </div>
</section>

<!-- ============ 2. BỐN TRỤ CỘT ============ -->
<section class="sec" aria-labelledby="h-tru-cot">
  <div class="wrap">
    <div class="sec__head reveal">
      <p class="eyebrow">Vì sao là Cuốn Sinh</p>
      <h2 id="h-tru-cot">Bốn điều quán giữ trong từng bữa</h2>
    </div>
    <ul class="pillars">
      <li class="pillar reveal">
        <span class="pillar__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 14-14 0 9-4 14-12 14M5 19c2-5 5-8 9-10"/></svg></span>
        <h3>Tươi</h3>
        <p>Rau xanh, thịt, hải sản lên bàn còn tươi, cuốn đến đâu ngon đến đó.</p>
      </li>
      <li class="pillar reveal">
        <span class="pillar__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-9.6A4 4 0 0 1 12 8a4 4 0 0 1 7 2.4C19 15.6 12 20 12 20z"/></svg></span>
        <h3>Tử tế</h3>
        <p>Giá niêm yết rõ ràng, phần ăn đúng như thực đơn.</p>
      </li>
      <li class="pillar reveal">
        <span class="pillar__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 11.5 12 5l8 6.5M6.5 10v9h11v-9M10 19v-5h4v5"/></svg></span>
        <h3>Ấm áp</h3>
        <p>Bàn ăn bày ra để chia sẻ: mỗi người một tay cuốn, câu chuyện tự nhiên rôm rả.</p>
      </li>
      <li class="pillar reveal">
        <span class="pillar__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="m8.5 12.2 2.4 2.4 4.6-5"/></svg></span>
        <h3>Chuẩn</h3>
        <p>Món Việt nấu đúng vị, ra món đều tay, hôm nay ngon thế nào thì lần sau vẫn vậy.</p>
      </li>
    </ul>
  </div>
</section>

<!-- ============ 3. MÓN NỔI BẬT ============ -->
<section class="sec sec--alt" id="mon-noi-bat" aria-labelledby="h-mon">
  <div class="wrap">
    <div class="sec__head sec__head--row reveal">
      <div>
        <p class="eyebrow">Thực đơn</p>
        <h2 id="h-mon">Món nên thử ở Cuốn Sinh</h2>
      </div>
      <div class="tabs" role="group" aria-label="Lọc món theo nhóm">
        <button type="button" class="tab is-on" data-cat="hot" aria-pressed="true" data-them-href="/thuc-don/" data-them-chu="Xem thực đơn đầy đủ">Nổi bật</button>
        {nhomHome.map((n) => (
          <button type="button" class="tab" data-cat={n.slug} aria-pressed="false" data-them-href={'/thuc-don/#' + n.slug} data-them-chu={'Xem thêm ' + n.goiLa}>{n.ten}</button>
        ))}
      </div>
    </div>

    <ul class="dishes" id="ds-mon">
      {nhomHome.map((n) => monTrangChu(n).map((m) => <TheMon mon={m} chip={n.ten} cat={n.slug} />))}
    </ul>

    <div class="more reveal">
      <a class="btn btn--ghost btn--more" id="xem-them-mon" href="/thuc-don/">Xem thực đơn đầy đủ</a>
      <p class="note">Chưa biết chọn món nào? <a href={MESSENGER_URL} target="_blank" rel="noopener">Nhắn fanpage Cuốn Sinh</a> để được tư vấn thêm về món ăn.</p>
    </div>
  </div>
</section>

<!-- ============ 4. COMBO THEO SỐ NGƯỜI ============ -->
<section class="sec" id="combo" aria-labelledby="h-combo">
  <div class="wrap">
    <div class="sec__head reveal">
      <p class="eyebrow">Combo</p>
      <h2 id="h-combo">Đi mấy người, quán gợi ý luôn</h2>
      <p class="sec__sub">Chọn số người, quán bày sẵn mâm vừa đủ.</p>
    </div>

    <div class="people reveal" role="group" aria-label="Chọn số người">
      {soNguoi.map((n, i) => (
        <button type="button" class:list={['people__btn', i === 0 && 'is-on']} data-people={n} aria-pressed={i === 0 ? 'true' : 'false'}><strong>{n}</strong> người</button>
      ))}
    </div>

    <ul class="combos" id="ds-combo" aria-live="polite">
      {COMBO.map((c) => <TheCombo combo={c} coForm />)}
    </ul>

    <p class="note reveal">Combo có lẩu gồm 1 nồi lẩu chọn trong các loại ghi ở combo. Món trong combo không đổi sang món khác, anh chị muốn thêm món thì gọi thêm theo giá lẻ.</p>
  </div>
</section>

<!-- ============ 5. KHÔNG GIAN, ĐI NHÓM ============ -->
<section class="sec sec--brand" id="khong-gian" aria-labelledby="h-kg">
  <div class="wrap space">
    <div class="space__text reveal">
      <p class="eyebrow">Không gian</p>
      <h2 id="h-kg">Hai tầng, đủ chỗ cho bữa trưa nhanh lẫn buổi liên hoan</h2>
      <p>Tầng 1 hợp nhóm nhỏ và bữa trưa văn phòng. Tầng 2 ghép được dãy bàn dài cho nhóm 24 đến 30 người ngồi liền nhau.</p>
      <p>Đoàn đông, sinh nhật, liên hoan công ty: anh chị gọi trước để quán xếp bàn cho gọn.</p>
      <a class="btn btn--light" href="tel:0844566922">Gọi 0844 566 922</a>
    </div>
    <ul class="stats reveal">
      <li><strong>2</strong><span>tầng</span></li>
      <li><strong>19</strong><span>bàn</span></li>
      <li><strong>76</strong><span>chỗ ngồi</span></li>
      <li><strong>24-30</strong><span>khách một dãy dài</span></li>
    </ul>
  </div>
</section>

<!-- ============ 6. ĐẶT BÀN ============ -->
<section class="sec" id="dat-ban" aria-labelledby="h-db">
  <div class="wrap book">
    <div class="book__info reveal">
      <p class="eyebrow">Đặt bàn</p>
      <h2 id="h-db">Giữ chỗ trong một phút</h2>
      <p>Điền thông tin, nhân viên Cuốn Sinh sẽ gọi lại xác nhận bàn cho anh chị.</p>
      <ul class="steps">
        <li><span>1</span>Chọn ngày, giờ và số người</li>
        <li><span>2</span>Quán gọi lại xác nhận</li>
        <li><span>3</span>Đến quán, bàn đã sẵn</li>
      </ul>
      <p class="book__call">Cần gấp trong hôm nay? Gọi <a href="tel:0844566922">0844 566 922</a></p>
    </div>

    <FormDatBan />
  </div>
</section>

<!-- ============ 7. LIÊN HỆ ============ -->
<section class="sec sec--alt" id="lien-he" aria-labelledby="h-lh">
  <div class="wrap">
    <div class="sec__head reveal">
      <p class="eyebrow">Ghé quán</p>
      <h2 id="h-lh">Cuốn Sinh ở đâu?</h2>
    </div>
    <ul class="contacts">
      <li class="contact reveal">
        <h3>Địa chỉ</h3>
        <p>Số 3, ngõ 58 Vũ Trọng Phụng, Thanh Xuân, Hà Nội</p>
        <a class="link" href="https://www.google.com/maps/search/?api=1&amp;query=Nh%C3%A0+h%C3%A0ng+Cu%E1%BB%91n+Sinh%2C+S%E1%BB%91+3+ng%C3%B5+58+V%C5%A9+Tr%E1%BB%8Dng+Ph%E1%BB%A5ng%2C+Thanh+Xu%C3%A2n%2C+H%C3%A0+N%E1%BB%99i" target="_blank" rel="noopener">Chỉ đường trên Google Maps</a>
      </li>
      <li class="contact reveal">
        <h3>Giờ nhận khách</h3>
        <p>Ca trưa 9:00 - 14:00<br>Ca tối 16:30 - 22:00</p>
      </li>
      <li class="contact reveal">
        <h3>Đặt bàn, hỏi món</h3>
        <p><a class="big" href="tel:0844566922">0844 566 922</a></p>
        <a class="link" href="https://m.me/nhahangcuonsinh" target="_blank" rel="noopener">Nhắn Messenger</a>
      </li>
      <li class="contact reveal">
        <h3>Theo dõi quán</h3>
        <p>Món mới và ưu đãi đăng trên fanpage.</p>
        <a class="link" href="https://www.facebook.com/nhahangcuonsinh" target="_blank" rel="noopener">facebook.com/nhahangcuonsinh</a>
      </li>
    </ul>
  </div>
</section>

</Base>
