---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { FACEBOOK_URL } from '../../consts';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title="Tin tức" description="Tin tức, món mới và hướng dẫn từ nhà hàng Cuốn Sinh.">
	<header class="page-head wrap">
		<p class="eyebrow">Tin tức</p>
		<h1>Chuyện ở Cuốn Sinh</h1>
		<p class="lead">Món mới, ưu đãi và những điều nên biết trước khi ghé quán.</p>
	</header>

	<section class="sec sec--tight">
		<div class="wrap">
			{
				posts.length > 0 ? (
					<ul class="posts">
						{posts.map((post) => (
							<li>
								<a class="post-card" href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<div class="post-card__img">
											<Image width={720} height={405} src={post.data.heroImage} alt="" />
										</div>
									)}
									<div class="post-card__body">
										<p class="post-card__date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h2>{post.data.title}</h2>
										<p>{post.data.description}</p>
										<span class="link">Đọc bài</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				) : (
					<div class="empty">
						<h2>Chưa có bài viết</h2>
						<p>Món mới và ưu đãi hiện được đăng trên fanpage của quán.</p>
						<a class="btn btn--primary" href={FACEBOOK_URL} target="_blank" rel="noopener">
							Xem fanpage
						</a>
					</div>
				)
			}
		</div>
	</section>
</Base>
