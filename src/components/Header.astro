---
// Thanh đầu trang dính. Ở trang chủ các mục cuộn tới khối trong trang,
// ở trang khác thì dẫn về đúng khối đó của trang chủ.
// Mục "Thực đơn": bấm thì sang trang /thuc-don/, rê chuột (hoặc bấm mũi tên trên
// điện thoại) thì sổ ra các nhóm món lấy từ src/data/thuc-don.mjs.
import { NHOM_MON } from '../data/thuc-don.mjs';

const path = Astro.url.pathname;
const isHome = path === '/';
const home = isHome ? '' : '/';
const here = (prefix: string) => (path.startsWith(prefix) ? 'is-here' : undefined);
---

<header class="top" id="dau-trang">
	<div class="wrap top__in">
		<a
			class="logo"
			href={isHome ? '#dau-trang' : '/'}
			aria-label={isHome ? 'Cuốn Sinh - về đầu trang' : 'Cuốn Sinh - về trang chủ'}
		>
			<img src="/assets/logo-cuon-sinh.png" alt="Cuốn Sinh" width="640" height="243" />
		</a>

		<nav class="nav" id="menu-chinh" aria-label="Điều hướng chính">
			<div class="nav__item">
				<a href="/thuc-don/" class={here('/thuc-don')}>Thực đơn</a>
				<button
					class="nav__more"
					type="button"
					aria-controls="menu-thuc-don"
					aria-expanded="false"
					aria-label="Mở các nhóm món"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
				</button>
				<ul class="sub" id="menu-thuc-don" aria-label="Các nhóm món">
					{NHOM_MON.map((n) => (
						<li>
							<a href={'/thuc-don/#' + n.slug}>{n.ten}</a>
						</li>
					))}
				</ul>
			</div>
			<a href={home + '#combo'}>Combo</a>
			<a href={home + '#khong-gian'}>Không gian</a>
			<a href="/about/" class={here('/about')}>Giới thiệu</a>
			<a href="/blog/" class={here('/blog')}>Tin tức</a>
			<a href={home + '#lien-he'}>Liên hệ</a>
			<a class="nav__cta" href={home + '#dat-ban'}>Đặt bàn</a>
		</nav>

		<div class="top__tools">
			<a class="btn btn--primary btn--sm top__book" href={home + '#dat-ban'}>Đặt bàn</a>
			<button
				class="icon-btn menu-btn"
				type="button"
				aria-controls="menu-chinh"
				aria-expanded="false"
				aria-label="Mở menu"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true"
					><path class="menu-btn__a" d="M4 7h16M4 12h16M4 17h16"></path><path
						class="menu-btn__b"
						d="M6 6l12 12M18 6L6 18"></path></svg
				>
			</button>
			<!-- Nút đổi giao diện: luôn ở góc trên bên phải -->
			<button
				class="icon-btn theme-btn"
				type="button"
				id="nut-giao-dien"
				aria-label="Đổi giao diện sáng tối"
				title="Đổi giao diện sáng/tối"
			>
				<svg class="theme-btn__sun" viewBox="0 0 24 24" aria-hidden="true"
					><circle cx="12" cy="12" r="4.2"></circle><path
						d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M18.7 5.3L17 7M7 17l-1.7 1.7"
					></path></svg
				>
				<svg class="theme-btn__moon" viewBox="0 0 24 24" aria-hidden="true"
					><path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2z"></path></svg
				>
			</button>
		</div>
	</div>
</header>
