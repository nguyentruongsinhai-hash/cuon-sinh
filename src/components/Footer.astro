---
import { FACEBOOK_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="foot">
	<div class="wrap foot__in">
		<div>
			<img
				class="foot__logo"
				src="/assets/logo-cuon-sinh.png"
				alt="Cuốn Sinh"
				width="640"
				height="243"
				loading="lazy"
			/>
			<p>Tươi ngon mỗi cuốn, ấm áp mỗi bữa.</p>
		</div>
		<nav class="foot__links" aria-label="Liên kết cuối trang">
			<a href="/thuc-don/">Thực đơn</a>
			<a href="/about/">Giới thiệu</a>
			<a href="/blog/">Tin tức</a>
			<a href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook</a>
			<a href="/dieu-khoan-dich-vu/">Điều khoản dịch vụ</a>
			<a href="/chinh-sach-bao-mat/">Chính sách bảo mật</a>
			<a href="/xoa-du-lieu/">Hướng dẫn xoá dữ liệu</a>
		</nav>
		<p class="foot__copy">© {year} Nhà hàng Cuốn Sinh</p>
	</div>
</footer>
