---
// Cụm nút liên hệ nổi ở góc phải dưới, có trên mọi trang (gắn trong Base.astro).
// Mỗi nút mở đúng kênh của nó: Zalo mở khung chat với số của quán, hotline mở
// màn hình gọi của máy khách với số đã điền sẵn, Messenger mở chat với Fanpage.
import { HOTLINE, HOTLINE_TEL, MESSENGER_URL, ZALO_URL } from '../consts';
---

<aside class="lien-he" aria-label="Liên hệ nhanh">
	<a
		class="lien-he__nut lien-he__nut--zalo"
		href={ZALO_URL}
		target="_blank"
		rel="noopener"
		aria-label="Nhắn Zalo cho Cuốn Sinh"
	>
		<span class="lien-he__zalo" aria-hidden="true">Zalo</span>
		<span class="lien-he__nhan" aria-hidden="true">Nhắn Zalo</span>
	</a>
	<a class="lien-he__nut lien-he__nut--goi" href={HOTLINE_TEL} aria-label={`Gọi hotline ${HOTLINE}`}>
		<svg viewBox="0 0 24 24" aria-hidden="true"
			><path
				d="M6.5 4h3l1.5 4-2 1.5a11 11 0 0 0 5.5 5.5l1.5-2 4 1.5v3A2.5 2.5 0 0 1 17.5 20 13.5 13.5 0 0 1 4 6.5 2.5 2.5 0 0 1 6.5 4z"
			></path></svg
		>
		<span class="lien-he__nhan" aria-hidden="true">Gọi {HOTLINE}</span>
	</a>
	<a
		class="lien-he__nut lien-he__nut--mess"
		href={MESSENGER_URL}
		target="_blank"
		rel="noopener"
		aria-label="Nhắn Messenger cho Fanpage Cuốn Sinh"
	>
		<svg viewBox="0 0 24 24" aria-hidden="true"
			><path
				d="M12 3.5c-5 0-8.75 3.6-8.75 8.2 0 2.5 1.1 4.7 2.9 6.2v3.1l2.9-1.6c.93.26 1.92.4 2.95.4 5 0 8.75-3.6 8.75-8.1S17 3.5 12 3.5z"
			></path><path class="lien-he__tia" d="M7.4 14.2l3.3-3.6 2.4 2 3.5-2.9-3.3 3.7-2.4-2z"></path></svg
		>
		<span class="lien-he__nhan" aria-hidden="true">Nhắn Messenger</span>
	</a>
</aside>
