---
// Thanh thao tác nhanh ở đáy màn hình điện thoại.
import { HOTLINE_TEL, MAPS_URL, ZALO_URL } from '../consts';

const home = Astro.url.pathname === '/' ? '' : '/';
---

<nav class="dock" aria-label="Thao tác nhanh">
	<a href={HOTLINE_TEL}
		><svg viewBox="0 0 24 24" aria-hidden="true"
			><path
				d="M6.5 4h3l1.5 4-2 1.5a11 11 0 0 0 5.5 5.5l1.5-2 4 1.5v3A2.5 2.5 0 0 1 17.5 20 13.5 13.5 0 0 1 4 6.5 2.5 2.5 0 0 1 6.5 4z"
			></path></svg
		>Gọi</a
	>
	<a href={ZALO_URL} target="_blank" rel="noopener"
		><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v11H9.5L5 20v-3.5H4z"></path></svg
		>Nhắn tin</a
	>
	<a href={MAPS_URL} target="_blank" rel="noopener"
		><svg viewBox="0 0 24 24" aria-hidden="true"
			><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"></path><circle
				cx="12"
				cy="10"
				r="2.3"></circle></svg
		>Chỉ đường</a
	>
	<a class="dock__main" href={home + '#dat-ban'}
		><svg viewBox="0 0 24 24" aria-hidden="true"
			><path d="M5 6.5h14v13H5zM5 10.5h14M9 4v4M15 4v4"></path></svg
		>Đặt bàn</a
	>
</nav>
