---
// Khung chung của mọi trang: đầu trang, chân trang, thanh thao tác nhanh,
// giao diện sáng/tối. Script giao diện được nhúng thẳng vào <head> để chạy
// trước khi trang vẽ (không nháy màu); logic nằm ở src/scripts/theme.cjs.
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LienHeNoi from '../components/LienHeNoi.astro';
import { DEFAULT_OG_IMAGE, GA_ID, SITE_DESCRIPTION, SITE_NAME, SITE_TITLE } from '../consts';
import { duongDanLd, goiLd } from '../lib/schema.mjs';
import themeScript from '../scripts/theme.cjs?raw';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	ogType?: string;
	/** Chữ mô tả ảnh chia sẻ (Facebook, Zalo đọc cho người dùng trình đọc màn hình) */
	imageAlt?: string;
	/** Trang không nên lên Google (trang báo lỗi 404) */
	noindex?: boolean;
	/** Các cấp nằm giữa Trang chủ và trang này, ví dụ bài viết nằm dưới Tin tức */
	capCha?: { ten: string; path: string }[];
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = DEFAULT_OG_IMAGE,
	ogType = 'website',
	imageAlt = 'Món ăn tại Nhà hàng Cuốn Sinh',
	noindex = false,
	capCha = [],
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const gaSrc = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
// Đường dẫn phân cấp cho Google (Trang chủ > ... > trang này). Trang chủ và trang
// lỗi không cần. Trang chủ tự khai nhà hàng qua slot "head".
const duongDan =
	title && !noindex && Astro.url.pathname !== '/'
		? goiLd(duongDanLd(Astro.site, [...capCha, { ten: title, path: Astro.url.pathname }]))
		: null;
---

<!doctype html>
<html lang="vi" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#fbf8f1" />
		{
			noindex ? (
				<meta name="robots" content="noindex,follow" />
			) : (
				<>
					<meta name="robots" content="index,follow,max-image-preview:large" />
					<link rel="canonical" href={canonical} />
				</>
			)
		}
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content="vi_VN" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		{duongDan && <script is:inline type="application/ld+json" set:html={duongDan} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- iPhone không dùng favicon.svg: thiếu apple-touch-icon thì màn hình chính ra ô đen chữ "C" -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Cuốn Sinh" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
		<!-- Đặt giao diện sáng/tối TRƯỚC khi trang vẽ ra để không nháy màu -->
		<script is:inline set:html={themeScript} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/assets/css/site.css" />
		<!-- Google Analytics 4: đếm lượt vào trang. Tải async nên không chặn trang vẽ. -->
		<script is:inline async src={gaSrc}></script>
		<script is:inline define:vars={{ GA_ID }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', GA_ID);
		</script>
		<slot name="head" />
	</head>
	<body>
		<a class="skip" href="#noi-dung">Bỏ qua, tới nội dung chính</a>
		<Header />
		<main id="noi-dung">
			<slot />
		</main>
		<Footer />
		<LienHeNoi />
		<Dock />
		<script is:inline src="/assets/js/site.js" defer></script>
	</body>
</html>
